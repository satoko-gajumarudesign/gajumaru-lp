---
// src/components/ui/WaveDivider.astro

export interface Props {
  colorClass?: string; 
}

const { 
  colorClass = "fill-white",
   } = Astro.props;
---

<div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">
  <svg 
  xmlns="http://www.w3.org/2000/svg" 
  viewBox="0 0 1200 120" 
  preserveAspectRatio="none" 
  class="relative block w-full h-50 sm:h-100 rotate-180"
  aria-hidden="true"
>
  <!-- 背景を塗りつぶす図形（線なし） -->
  <path 
    d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" 
    class={`${colorClass}`} 
  ></path>
  
  <!-- 波の部分だけの線（塗りつぶしなし、金色の線） -->
  <path 
    d="M0,27.35 A600.21,600.21,0,0,0,321.39,56.44 c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3" 
    fill="none"
    class="stroke-wave-gold stroke-[4px]" 
    vector-effect="non-scaling-stroke"
  ></path>
</svg>
</div>