---
// src/components/sections/About.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import AboutGaju from "@/assets/images/about_gaju.jpg";
import FlowerIcon from "@/assets/icons/flower_icon.png";
import BallIcon from "@/assets/icons/ball_icon.png";
import SocksIcon from "@/assets/icons/socks_icon.png";
---

<section
    id="about"
    class="relative bg-custom-gray text-tx-white overflow-hidden md:px-[10%]"
>
    <div
        class="grid grid-cols-1 md:grid-cols-2 place-items-center m-auto max-w-[90%] py-40 md:pb-150 md:pt-80 gap-10"
    >
        <div class="flex flex-col items-start gap-5 md:gap-20">
            <div
                class="flex flex-col w-full text-center sm:text-start gap-10 md:gap-40"
            >
                <h2 class="text-fluid-xl">ABOUT GAJUMARU</h2>
                <p
                    class="text-3xl md:text-5xl leading-30 md:leading-60 tracking-wide"
                >
                    Hello I'm Gajumaru!<br />
                    7 years old, shiba inu boy.<br />
                    I love to play!
                </p>
            </div>
            <ul class="flex">
                <li>
                    <Image
                        src={FlowerIcon}
                        alt="散歩中に見かける花と蜂をイメージしたアイコン"
                    />
                </li>
                <li>
                    <Image
                        src={BallIcon}
                        alt="遊びに使うサッカーボールをイメージしたアイコン"
                    />
                </li>
                <li>
                    <Image
                        src={SocksIcon}
                        alt="いたずらで噛んだり、振り回す靴下をイメージしたアイコン"
                    />
                </li>
            </ul>
        </div>

        <figure
            data-animate="animate-about-fadein"
            class="md:max-w-full js-fade-init"
        >
            <Image
                widths={[400, 800, 1200]}
                sizes="(max-width: 768px) 90vw, 50vw"
                class="object-cover w-full h-full rounded-[50%]"
                src={AboutGaju}
                alt="お城の前に横向きに立ち、こちらを向いている愛犬がじゅまる"
            />
        </figure>
    </div>

    <WaveDivider colorClass="fill-custom-dark" />
</section>
