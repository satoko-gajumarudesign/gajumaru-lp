---
// src/components/sections/History.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import { historyItems } from "@/data/history.ts";
import dogIcon from "@/assets/icons/dog_icon.png";
import heartIcon from "@/assets/icons/heart_icon.png";
import tennisballIcon from "@/assets/icons/tennisball_icon.png";
import filmIcon from "@/assets/icons/film_icon.png";
import projectorIcon from "@/assets/icons/projector_icon.png";
---

<section id="history" class="bg-custom-gray">
    <div class="pt-60 pb-200">
        <div class="relative w-fit mx-auto mb-150 md:mb-200">
            <h2 class="text-fluid-xl text-center text-tx-white">
                GAJUMARU's HISTORY
            </h2>
            <Image
                class="absolute top-[-25%] right-[0%] md:right-[-16%] w-[20%] rotate-20"
                src={filmIcon}
                alt=""
            />
            <Image
                class="absolute top-[-40%] md:top-[-70%] left-[-3%] md:left-[-20%] w-[25%]"
                src={projectorIcon}
                alt=""
            />
            <Image
                    class="absolute top-[90%] md:top-[65%] left-[30%] md:left-[15%] w-[15%]"
                    src={tennisballIcon}
                    alt=""
                />
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 place-items-center m-auto max-w-[90%] md:max-w-[70%] gap-y-110 md:gap-y-150"
        >
            {
                historyItems.map((item, index) => {
                    const isEven = index % 2 === 1;

                    return (
                        <article class="max-w-sm w-[90%] md:w-full  border border-wave-gold bg-[#D9D9D9] relative p-32 rounded-md md:even:translate-y-[6em] justify-self-start even:justify-self-end md:justify-self-center md:evenjustify-self-center">
                            {item.decorations &&
                                item.decorations.map((deco) => (
                                    <div
                                        class={`absolute z-20 ${deco.position}`}
                                    >
                                        <Image
                                            class="w-full"
                                            src={deco.image}
                                            alt={deco.alt}
                                        />
                                    </div>
                                ))}

                            <div
                                class={`flex flex-col gap-16 relative z-10 ${isEven ? "items-start text-left" : "items-end text-right"}`}
                            >
                                <h3 class="text-2xl md:text-4xl font-medium">
                                    {item.title}
                                </h3>
                                <p class="text-xl md:text-3xl text-left">{item.text}</p>
                            </div>

                            <div
                                class={`absolute w-130 md:w-150 top-0 -translate-y-1/2 ${
                                    isEven
                                        ? "right-0 md:translate-x-1/4"
                                        : "left-0 md:-translate-x-1/4"
                                }`}
                            >
                                {item.image && (
                                    <Image
                                        class="w-full"
                                        src={item.image}
                                        alt={item.alt}
                                    />
                                )}
                            </div>
                        </article>
                    );
                })
            }

            <div class="w-150 md:w-250 -translate-x-50 relative">
                <Image class="w-full" src={dogIcon} alt="" />
                <Image
                    class="absolute top-[-35%] right-[-16%] w-[40%] rotate-25"
                    src={heartIcon}
                    alt=""
                />
                <Image
                    class="absolute bottom-[-5%] right-[-50%] w-[50%]"
                    src={tennisballIcon}
                    alt=""
                />
            </div>
        </div>
    </div>

    <WaveDivider colorClass="fill-custom-dark"/>
</section>
