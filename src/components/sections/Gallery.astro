---
// src/components/sections/Gallery.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import { dogImages } from "@/data/gallery.ts";
import { navButtons } from "@/data/gallery.ts";
---

<section id="gallery" class="bg-custom-dark pt-60 pb-100 relative">
    <div>
        <h2 class="text-fluid-xl text-center text-wave-gold">LOVELY MOMENTS</h2>

        <div
            id="gallery-container"
            class="w-full overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
            <ul class="flex gap-20 md:gap-[10vw] py-80 px-[10vw] md:px-[calc(50%-250px)] w-max" role="list">
                {
                    dogImages.map((image, index) => (
                        <li class="snap-center shrink-0 w-[80vw] md:w-500 overflow-hidden group p-10 bg-white gallery-item">
                            <button
                                type="button"
                                class="gallery-trigger w-full h-full text-left cursor-pointer overflow-hidden block relative"
                                aria-label={`${index + 1}枚目の画像: ${image.alt} にフォーカス`}
                            >
                                <Image
                                    src={image.src}
                                    alt={image.alt}
                                    class="w-full h-full object-cover"
                                />
                            </button>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="hidden md:flex justify-center items-center gap-100">
        {
            navButtons.map((btn) => (
                <button
                    type="button"
                    id={btn.id}
                    aria-label={btn.label}
                    class="group flex items-center justify-center size-60 rounded-full border border-wave-gold/40 bg-white/5 text-wave-gold/80 backdrop-blur-sm transition-all duration-300 hover:border-wave-gold hover:bg-wave-gold/15 hover:text-wave-gold hover:shadow-[0_0_15px_rgba(200,166,31,0.35)] cursor-pointer disabled:opacity-25 disabled:pointer-events-none disabled:shadow-none"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class:list={[
                            "size-40 transition-transform duration-300",
                            btn.isNext
                                ? "rotate-180 group-hover:translate-x-5"
                                : "group-hover:-translate-x-5",
                        ]}
                        aria-hidden="true"
                    >
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                </button>
            ))
        }
    </div>

    <WaveDivider colorClass="fill-custom-gray" />
</section>

<script>
    const container = document.getElementById("gallery-container") as HTMLButtonElement;
    const btnPrev = document.getElementById("btn-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-next") as HTMLButtonElement;
    const items = document.querySelectorAll(".gallery-item");
    const triggers = document.querySelectorAll(".gallery-trigger");

    const getScrollAmount = () => {
        // 1つ目と2つ目の左端の距離（要素の幅＋gap）を計算
        if (items.length >= 2) {
            const firstItem = items[0] as HTMLElement;
            const secondItem = items[1] as HTMLElement;
            return secondItem.offsetLeft - firstItem.offsetLeft;
        }
        // 要素が1つしか取得できなかった場合
        const singleItem = items[0] as HTMLElement;
        return singleItem?.offsetWidth || 300;
    };

    const updateButtons = () => {
        if (!container || !btnPrev || !btnNext) return;

        // 1枚目が中央にあるとき（左端）は「前へ」を無効化
        const isAtStart = container.scrollLeft <= 4;
        btnPrev.disabled = isAtStart;

        // 最後の写真が中央にあるとき（右端）は「次へ」を無効化
        const isAtEnd =
            container.scrollLeft + container.clientWidth >=
            container.scrollWidth - 4;
        btnNext.disabled = isAtEnd;
    };

    // スクロール時と画面リサイズ時にボタンの状態を更新
    container?.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();

    // 各画像をクリックした時に真ん中にスクロールさせる
    triggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
            const item = (event.currentTarget as HTMLElement).closest(
                ".gallery-item",
            );

            if (item) {
                item.scrollIntoView({
                    behavior: "smooth",
                    inline: "center",
                    block: "nearest", // 縦方向の余計なスクロールを防ぐ
                });
            }
        });
    });

    // 戻るボタンのクリックイベント
    btnPrev?.addEventListener("click", () => {
        container?.scrollBy({
            left: -getScrollAmount(),
            behavior: "smooth",
        });
    });

    // 次へボタンのクリックイベント
    btnNext?.addEventListener("click", () => {
        container?.scrollBy({
            left: getScrollAmount(),
            behavior: "smooth",
        });
    });
</script>
