---
// src/components/sections/Gallery.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import Gallery1 from "@/assets/images/gallery_1.jpeg";
import Gallery2 from "@/assets/images/gallery_2.jpg";
import Gallery3 from "@/assets/images/gallery_3.jpeg";
import Gallery4 from "@/assets/images/gallery_4.jpeg";
import Gallery5 from "@/assets/images/gallery_5.jpeg";
import Gallery6 from "@/assets/images/gallery_6.jpeg";

const dogImages = [
    { src: Gallery1, alt: "リビングのソファの横に伏せって顔を上げている愛犬がじゅまる" },
    { src: Gallery2, alt: "ソファの上に仰向けになって、こちらを見上げている愛犬がじゅまる" },
    { src: Gallery3, alt: "室内でおすわりをした状態でこちらを見上げている愛犬がじゅまる" },
    { src: Gallery4, alt: "カーテンの前に伏せった状態の愛犬がじゅまるのお尻と尻尾" },
    { src: Gallery5, alt: "こちらから少し距離を取って、ソファの下に潜り込み、そっぽを向いている愛犬がじゅまる" },
    { src: Gallery6, alt: "キャンプ場でテントの中に横向きに立っている愛犬がじゅまる" },
];

const navButtons = [
    { id: "btn-prev", label: "前の画像へ", isNext: false },
    { id: "btn-next", label: "次の画像へ", isNext: true },
];
---

<section id="gallery" class="bg-custom-dark pt-60 pb-100 relative">
    <div>
        <h2 class="text-fluid-xl text-center text-wave-gold">LOVELY MOMENTS</h2>

        <div
            id="gallery-container"
            class="w-full px-50 md:px-500 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
            <ul class="flex gap-20 md:gap-[10vw] p-80 w-max" role="list">
                {
                    dogImages.map((image, index) => (
                        <li class="snap-center shrink-0 w-[80vw] md:w-500 overflow-hidden group p-10 bg-white gallery-item">
                            <button
                                type="button"
                                class="gallery-trigger w-full h-full text-left cursor-pointer overflow-hidden block relative"
                                aria-label={`${index + 1}枚目の画像: ${image.alt} にフォーカス`}
                            >
                                <Image
                                    src={image.src}
                                    alt={image.alt}
                                    class="w-full h-full object-cover"
                                />
                            </button>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="hidden md:flex justify-center items-center gap-100">
        {
            navButtons.map((btn) => (
                <button
                    type="button"
                    id={btn.id}
                    aria-label={btn.label}
                    class="group flex items-center justify-center size-60 rounded-full border border-wave-gold/40 bg-white/5 text-wave-gold/80 backdrop-blur-sm transition-all duration-300 hover:border-wave-gold hover:bg-wave-gold/15 hover:text-wave-gold hover:shadow-[0_0_15px_rgba(200,166,31,0.35)] cursor-pointer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class:list={["size-40 transition-transform duration-300",
          btn.isNext ? "rotate-180 group-hover:translate-x-5" : "group-hover:-translate-x-5"]}
                        aria-hidden="true"
                    >
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                </button>
            ))
        }
    </div>

    <WaveDivider colorClass="fill-custom-gray"/>
</section>

<script>
    const container = document.getElementById("gallery-container");
    const btnPrev = document.getElementById("btn-prev");
    const btnNext = document.getElementById("btn-next");
    const items = document.querySelectorAll(".gallery-item");
    const triggers = document.querySelectorAll(".gallery-trigger");

    const scrollAmount = 324;

    const updateButtons = () => {
        if (!container || !btnPrev || !btnNext) return;

        if (container.scrollLeft <= 4) {
            // 誤差を考慮して少し余裕を持たせる
            btnPrev.setAttribute("disabled", "true");
        } else {
            btnPrev.removeAttribute("disabled");
        }

        const isAtEnd =
            container.scrollLeft + container.clientWidth >=
            container.scrollWidth - 4;

        if (isAtEnd) {
            btnNext.setAttribute("disabled", "true");
        } else {
            btnNext.removeAttribute("disabled");
        }
    };

    // スクロール時の監視
    container?.addEventListener("scroll", updateButtons);
    updateButtons();

    // 各画像をクリックした時に真ん中にスクロールさせる
    triggers.forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
            const item = (event.currentTarget as HTMLElement).closest(
                ".gallery-item",
            );

            if (item) {
                item.scrollIntoView({
                    behavior: "smooth",
                    inline: "center",
                    block: "nearest", // 縦方向の余計なスクロールを防ぐ
                });
            }
        });
    });

    // 戻るボタンのクリックイベント
    btnPrev?.addEventListener("click", () => {
        container?.scrollBy({
            left: -scrollAmount,
            behavior: "smooth",
        });
    });

    // 次へボタンのクリックイベント
    btnNext?.addEventListener("click", () => {
        container?.scrollBy({
            left: scrollAmount,
            behavior: "smooth",
        });
    });
</script>
