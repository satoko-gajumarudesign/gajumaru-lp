---
// src/components/sections/Gallery.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import AboutGaju from "@/assets/images/about_gaju.jpg";

const dogImages = [
    { src: AboutGaju, alt: "姫路城とがじゅまる" },
    { src: AboutGaju, alt: "" },
    { src: AboutGaju, alt: "" },
    { src: AboutGaju, alt: "" },
    { src: AboutGaju, alt: "" },
    { src: AboutGaju, alt: "" },
];
---

<section id="gallery" class="bg-custom-dark pt-60 pb-100 relative">
    <div>
        <h2 class="text-fluid-xl text-center text-wave-gold">LOVELY MOMENTS</h2>

        <div id="gallery-container"
            class="w-full px-50 md:px-500 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
            <ul class="flex gap-20 md:gap-[10vw] p-80 w-max" role="list">
                {
                    dogImages.map((image,index) => (
                        <li class="snap-center shrink-0 w-[80vw] md:w-500 overflow-hidden group p-10 bg-white gallery-item">
                            <button
                            type="button"
                            class="gallery-trigger w-full h-full text-left cursor-pointer overflow-hidden block relative"
                            aria-label={`${index + 1}枚目の画像: ${image.alt} にフォーカス`}>
                                <Image
                                    src={image.src}
                                    alt={image.alt}
                                    class="w-full h-full object-cover"
                                />
                            </button>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <div class="hidden md:flex gap-3">
        <button 
          id="btn-prev" 
          class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors cursor-pointer"
          aria-label="前の画像へ"
        >
          {/* 左向き矢印のSVGアイコン */}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        
        <button 
          id="btn-next" 
          class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors cursor-pointer"
          aria-label="次の画像へ"
        >
          {/* 右向き矢印のSVGアイコン */}
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
</section>

<script>    
    const container = document.getElementById('gallery-container');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const items = document.querySelectorAll('.gallery-item');
    const triggers = document.querySelectorAll('.gallery-trigger');
  
    const scrollAmount = 324;
  
const updateButtons = () => {
    if (!container || !btnPrev || !btnNext) return;

    if (container.scrollLeft <= 4) { // 誤差を考慮して少し余裕を持たせる
      btnPrev.setAttribute('disabled', 'true');
    } else {
      btnPrev.removeAttribute('disabled');
    }

    const isAtEnd = container.scrollLeft + container.clientWidth >= container.scrollWidth - 4;
    
    if (isAtEnd) {
      btnNext.setAttribute('disabled', 'true');
    } else {
      btnNext.removeAttribute('disabled');
    }
  };

  // スクロール時の監視
  container?.addEventListener('scroll', updateButtons);
  updateButtons();

  // 各画像をクリックした時に真ん中にスクロールさせる
  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      const item = (event.currentTarget as HTMLElement).closest('.gallery-item');

      if (item) {
        item.scrollIntoView({
          behavior: 'smooth',
          inline: 'center', 
          block: 'nearest'  // 縦方向の余計なスクロールを防ぐ
        });
      }
    });
  });

    // 戻るボタンのクリックイベント
    btnPrev?.addEventListener('click', () => {
      container?.scrollBy({ 
        left: -scrollAmount, 
        behavior: 'smooth' 
      });
    });
  
    // 次へボタンのクリックイベント
    btnNext?.addEventListener('click', () => {
      container?.scrollBy({ 
        left: scrollAmount, 
        behavior: 'smooth'
      });
    });
  </script>