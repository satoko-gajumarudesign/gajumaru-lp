---
// src/components/sections/History.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import { Image } from "astro:assets";
import Items1 from "@/assets/images/items_1.png";
import Items2 from "@/assets/images/items_2.png";
import dogIcon from "@/assets/icons/dog_icon.png";
---

<section id="items" class="bg-custom-gray pt-60 pb-150 relative">
    <div class="flex flex-col gap-50">
        <h2 class="text-fluid-xl text-center text-tx-white">
            Original Items
            <span class="block text-2xl md:text-4xl">(Designs by Human)</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-80 sm:gap-50 w-[90%] sm:w-[70%] m-auto items-center">
            <Image
                class="w-full h-auto object-cover"
                src={Items1}
                alt="愛犬がじゅまるの顔とその下に「What...？」の文字が描かれた白いTシャツ"
            />
            <Image
                class="w-full h-auto object-cover"
                src={Items2}
                alt="愛犬がじゅまるの顔とその下に「W..What？」の文字が描かれた白いTシャツ"
            />
        </div>
    </div>

    <WaveDivider colorClass="fill-custom-dark"/>
</section>
