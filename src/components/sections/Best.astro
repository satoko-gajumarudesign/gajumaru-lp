---
// src/components/sections/Best.astro
import WaveDivider from "@/components/ui/WaveDivider.astro";
import DecoratedHeading from "@/components/ui/DecoratedHeading.astro";
import StarImage from "@/components/ui/StarImage.astro";
import { Image } from "astro:assets";
import BestToy from "@/assets/images/best_toy.jpeg";
import BestSnack from "@/assets/images/best_snack.jpeg";
import BestPlace from "@/assets/images/best_place.jpeg";

const favoriteItems = [
    {
        title: "Toy",
        image: BestToy,
        alt: "がじゅまるとのひっぱり遊びに使うロープ",
        text: "I like having this rope pulled.",
    },
    {
        title: "Snack",
        image: BestSnack,
        alt: "毎晩、歯磨きの後のご褒美にもらう犬用ガム",
        text: "A treat after brushing my teeth.",
    },
    {
        title: "Place",
        image: BestPlace,
        alt: "がじゅまるがお昼寝に使っているコット",
        text: "It's my favorite place to chill.",
    },
];
---

<section id="best" class="relative bg-custom-dark pb-40 sm:pb-80">
    <div
        class="grid grid-cols-1 place-items-center m-auto max-w-[90%] py-30 md:py-60 gap-35 md:gap-50 text-tx-white"
    >
        <h2 class="text-fluid-xl text-center">
            GAJUMARU's Best
            <span
                class="flex items-center justify-center md:gap-15 gap-8 text-2xl md:text-4xl text-center text-wave-gold"
            >
                <DecoratedHeading />
                <span>Top Picks!</span>
                <DecoratedHeading className="-scale-x-100" />
            </span>
        </h2>

        <div class="grid grid-cols-3 gap-2 md:gap-5">
            {
                favoriteItems.map((item,index) => (
                    <article class="space-y-5">
                        <h3 class="text-center text-2xl md:text-4xl text-wave-gold">{item.title}</h3>

                        <figure class="flex flex-col items-center">
                            <div class="star-container"
                            data-animate="is-flipped"
                            style={`--delay: ${index * 0.2}s;`}
                            >
                                <StarImage src={item.image} alt={item.alt} />
                            </div>
                            <figcaption class="text-xs sm:text-lg px-5 sm:px-16">{item.text}</figcaption>
                        </figure>
                    </article>
                ))
            }
        </div>
    </div>

    <WaveDivider 
    colorClass="fill-custom-gray"/>
</section>

<style>
    .star-container {
        position: relative;
        width: 100%; 
        aspect-ratio: 1 / 1;
        
        background-color: var(--color-wave-gold);
        mask-image: url("/images/star-fill.svg");
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
        -webkit-mask-image: url("/images/star-fill.svg");
        -webkit-mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-position: center;

        transform-style: preserve-3d;
    }

    .star-container > :global(*) {
        opacity: 0;
    }

    .star-container.is-flipped {
        animation: flip-star 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: var(--delay, 0s);
    }

    .star-container.is-flipped > :global(*) {
        animation: reveal-image 0.8s linear forwards;
        animation-delay: var(--delay, 0s);
    }

    @keyframes flip-star {
        0% {
            transform: perspective(600px) rotateY(0deg) scale(0.9);
        }
        50% {
            transform: perspective(600px) rotateY(90deg) scale(1.08);
        }
        100% {
            transform: perspective(600px) rotateY(0deg) scale(1);
        }
    }

    @keyframes reveal-image {
        0%, 49% {
            opacity: 0;
        }
        50%, 100% {
            opacity: 1;
        }
    }
    </style>